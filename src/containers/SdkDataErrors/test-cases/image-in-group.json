{
  "id": "image_in_group",
  "name": "Image Field Inside Group",
  "description": "Tests setData on a file (image) field nested inside a single group. Uses dotted path media_pack.image.",
  "contentType": {
    "uid": "sdk_tc_image_group",
    "title": "SDK TC - Image In Group",
    "description": "Module for SDK image-in-group validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "media_pack",
        "data_type": "group",
        "display_name": "Media Pack",
        "mandatory": false,
        "unique": false,
        "multiple": false,
        "schema": [
          {
            "uid": "image",
            "data_type": "file",
            "display_name": "Image",
            "mandatory": false,
            "unique": false,
            "field_metadata": {},
            "multiple": false
          }
        ]
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Image In Group Entry",
    "media_pack": {
      "image": "bltaaa111"
    }
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "media_pack.image correct image id → resolves, no onError",
      "description": "Valid asset uid string on nested group file field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "media_pack.image",
        "subscribeFieldOnErrorUid": "media_pack.image",
        "data": "bltaaa111"
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "media_pack.image wrong image id → throws ValidationError",
      "description": "Non-existent asset uid. Host rejects after Zod passes.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "media_pack.image",
        "subscribeFieldOnErrorUid": "media_pack.image",
        "data": "blt_invalid_fake_asset_uid_xyz"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "media_pack.image null image id → resolves, no onError",
      "description": "null clears the nested file field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "media_pack.image",
        "subscribeFieldOnErrorUid": "media_pack.image",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "entry-sidebar"
}
