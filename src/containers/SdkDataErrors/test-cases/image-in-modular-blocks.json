{
  "id": "image_in_modular_blocks",
  "name": "Image Field Inside Modular Blocks",
  "description": "Tests setData on a file (image) field nested inside a modular block. Uses dotted path sections.0.media.image.",
  "contentType": {
    "uid": "sdk_tc_image_blocks",
    "title": "SDK TC - Image In Modular Blocks",
    "description": "Module for SDK image-in-modular-blocks validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "sections",
        "data_type": "blocks",
        "display_name": "Sections",
        "mandatory": false,
        "unique": false,
        "multiple": true,
        "blocks": [
          {
            "uid": "media",
            "title": "Media Block",
            "schema": [
              {
                "uid": "image",
                "data_type": "file",
                "display_name": "Image",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false
              }
            ]
          }
        ]
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Image In Modular Blocks Entry",
    "sections": [
      {
        "media": {
          "image": "bltaaa111"
        }
      }
    ]
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "sections.0.media.image correct image id → resolves, no onError",
      "description": "Valid asset uid string on nested block file field. Passes Zod and host.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections.0.media.image",
        "subscribeFieldOnErrorUid": "sections.0.media.image",
        "data": "bltaaa111"
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "sections.0.media.image wrong image id → throws ValidationError",
      "description": "Uid string with valid shape but asset does not exist on stack. Host rejects after Zod passes.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections.0.media.image",
        "subscribeFieldOnErrorUid": "sections.0.media.image",
        "data": "blt_invalid_fake_asset_uid_xyz"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "sections.0.media.image null image id → resolves, no onError",
      "description": "null clears the nested file field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections.0.media.image",
        "subscribeFieldOnErrorUid": "sections.0.media.image",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "entry-sidebar",
  "isExperimental": true
}
