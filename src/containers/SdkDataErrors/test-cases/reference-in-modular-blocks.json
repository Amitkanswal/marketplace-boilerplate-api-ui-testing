{
  "id": "reference_in_modular_blocks",
  "name": "Reference Field Inside Modular Blocks",
  "description": "Tests setData on a reference field nested inside a modular block. Uses dotted path sections.0.related.entry_ref.",
  "contentType": {
    "uid": "sdk_tc_ref_in_blocks",
    "title": "SDK TC - Reference In Modular Blocks",
    "description": "Module for SDK reference-in-modular-blocks validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "sections",
        "data_type": "blocks",
        "display_name": "Sections",
        "mandatory": false,
        "unique": false,
        "multiple": true,
        "blocks": [
          {
            "uid": "related",
            "title": "Related Block",
            "schema": [
              {
                "uid": "entry_ref",
                "data_type": "reference",
                "display_name": "Entry Reference",
                "mandatory": false,
                "unique": false,
                "field_metadata": {
                  "ref_multiple": false
                },
                "reference_to": [
                  "sdk_tc_ref_in_blocks"
                ],
                "multiple": false
              }
            ]
          }
        ]
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Reference In Modular Blocks Entry",
    "sections": [
      {
        "related": {
          "entry_ref": [
            {
              "_content_type_uid": "sdk_tc_ref_in_blocks",
              "uid": "self_uid"
            }
          ]
        }
      }
    ]
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "sections.0.related.entry_ref correct reference id → resolves, no onError",
      "description": "Valid {_content_type_uid, uid} on nested block reference field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections.0.related.entry_ref",
        "subscribeFieldOnErrorUid": "sections.0.related.entry_ref",
        "data": [{
          "_content_type_uid": "sdk_tc_ref_in_blocks",
          "uid": "self_uid"
        }]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "sections.0.related.entry_ref wrong reference id → throws ValidationError",
      "description": "Valid reference shape but entry uid does not exist. Host rejects after Zod passes.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections.0.related.entry_ref",
        "subscribeFieldOnErrorUid": "sections.0.related.entry_ref",
        "data": {
          "_content_type_uid": "sdk_tc_ref_in_blocks",
          "uid": "blt_wrong_entry_ref_fake"
        }
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "sections.0.related.entry_ref null reference id → resolves, no onError",
      "description": "null clears the nested reference field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections.0.related.entry_ref",
        "subscribeFieldOnErrorUid": "sections.0.related.entry_ref",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "sections.0.related.entry_ref invalid content type uid → throws ValidationError",
      "description": "_content_type_uid not in reference_to fails Zod before host.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "sections.0.related.entry_ref",
        "subscribeFieldOnErrorUid": "sections.0.related.entry_ref",
        "data": [{
          "_content_type_uid": "any_other_content_type",
          "uid": "self_uid"
        }]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "entry-sidebar",
  "isExperimental": true
}
