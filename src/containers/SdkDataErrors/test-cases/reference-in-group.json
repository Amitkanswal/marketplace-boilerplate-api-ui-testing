{
  "id": "reference_in_group",
  "name": "Reference Field Inside Group",
  "description": "Tests setData on a reference field nested inside a single group. Uses dotted path linked.entry_ref.",
  "contentType": {
    "uid": "sdk_tc_ref_in_group",
    "title": "SDK TC - Reference In Group",
    "description": "Module for SDK reference-in-group validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "linked",
        "data_type": "group",
        "display_name": "Linked",
        "mandatory": false,
        "unique": false,
        "multiple": false,
        "schema": [
          {
            "uid": "entry_ref",
            "data_type": "reference",
            "display_name": "Entry Reference",
            "mandatory": false,
            "unique": false,
            "field_metadata": {
              "ref_multiple": false
            },
            "reference_to": [
              "sdk_tc_ref_in_group"
            ],
            "multiple": false
          }
        ]
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Reference In Group Entry",
    "linked": {
      "entry_ref": [
        {
          "_content_type_uid": "sdk_tc_ref_in_group",
          "uid": "self_uid"
        }
      ]
    }
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "linked.entry_ref correct reference id → resolves, no onError",
      "description": "Valid {_content_type_uid, uid} on nested group reference field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "linked.entry_ref",
        "subscribeFieldOnErrorUid": "linked.entry_ref",
        "data": [{
          "_content_type_uid": "sdk_tc_ref_in_group",
          "uid": "self_uid"
        }]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "linked.entry_ref wrong reference id → throws ValidationError",
      "description": "Valid reference shape but entry uid does not exist. Host rejects after Zod passes.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "linked.entry_ref",
        "subscribeFieldOnErrorUid": "linked.entry_ref",
        "data": [{
          "_content_type_uid": "sdk_tc_ref_in_group",
          "uid": "blt_wrong_entry_ref_fake"
        }]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "linked.entry_ref null reference id → resolves, no onError",
      "description": "null clears the nested reference field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "linked.entry_ref",
        "subscribeFieldOnErrorUid": "linked.entry_ref",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "linked.entry_ref invalid content type uid → throws ValidationError",
      "description": "_content_type_uid not in reference_to fails Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "linked.entry_ref",
        "subscribeFieldOnErrorUid": "linked.entry_ref",
        "data": [{
          "_content_type_uid": "any_other_content_type",
          "uid": "self_uid"
        }]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "entry-sidebar"
}
