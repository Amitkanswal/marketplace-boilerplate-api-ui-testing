{
  "id": "reference_in_global_field",
  "name": "Reference Field Inside Global Field",
  "description": "Tests setData on a reference field nested inside a global field. Uses dotted path link_card.linked_entry.",
  "contentType": {
    "uid": "sdk_tc_ref_in_global",
    "title": "SDK TC - Reference In Global Field",
    "description": "Module for SDK reference-in-global-field validation tests",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "link_card",
        "data_type": "global_field",
        "display_name": "Link Card",
        "mandatory": false,
        "unique": false,
        "multiple": false,
        "reference_to": "sdk_tc_link_card_gf",
        "schema": [
          {
            "uid": "label",
            "data_type": "text",
            "display_name": "Label",
            "mandatory": false,
            "unique": false,
            "field_metadata": {},
            "multiple": false
          }
        ]
      }
    ]
  },
  "globalFieldUpdate": {
      "schema": [
        {
          "uid": "label",
          "data_type": "text",
          "display_name": "Label",
          "mandatory": false,
          "unique": false,
          "field_metadata": {},
          "multiple": false
        },
        {
          "uid": "linked_entry",
          "data_type": "reference",
          "display_name": "Linked Entry",
          "mandatory": false,
          "unique": false,
          "field_metadata": {
            "ref_multiple": false
          },
          "reference_to": [
            "sdk_tc_ref_in_global"
          ],
          "multiple": false
        }
      ]
  },
  "baseline": {
    "title": "SDK TC Reference In Global Field Entry",
    "link_card": {
      "label": "Self link",
      "linked_entry": [
        {
          "_content_type_uid": "sdk_tc_ref_in_global",
          "uid": "self_uid"
        }
      ]
    }
  },
  "testCases": [
    {
      "id": "TC-F-001",
      "name": "link_card.linked_entry correct reference id → resolves, no onError",
      "description": "Valid {_content_type_uid, uid} on nested global-field reference child.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "link_card.linked_entry",
        "subscribeFieldOnErrorUid": "link_card.linked_entry",
        "data": [{
          "_content_type_uid": "sdk_tc_ref_in_global",
          "uid": "self_uid"
        }]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-002",
      "name": "link_card.linked_entry wrong reference id → throws ValidationError",
      "description": "Valid reference shape but entry uid does not exist. Host rejects after Zod passes.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "link_card.linked_entry",
        "subscribeFieldOnErrorUid": "link_card.linked_entry",
        "data": [{
          "_content_type_uid": "sdk_tc_ref_in_global",
          "uid": "blt_wrong_entry_ref_fake"
        }]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-003",
      "name": "link_card.linked_entry null reference id → resolves, no onError",
      "description": "null clears the nested reference field.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "link_card.linked_entry",
        "subscribeFieldOnErrorUid": "link_card.linked_entry",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-F-004",
      "name": "link_card.linked_entry invalid content type uid → throws ValidationError",
      "description": "_content_type_uid not in reference_to fails Zod.",
      "operation": {
        "type": "field-setdata",
        "targetFieldUid": "link_card.linked_entry",
        "subscribeFieldOnErrorUid": "link_card.linked_entry",
        "data": [{
          "_content_type_uid": "any_other_content_type",
          "uid": "self_uid"
        }]
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR"
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "entry-sidebar",
  "isExperimental": true
}
