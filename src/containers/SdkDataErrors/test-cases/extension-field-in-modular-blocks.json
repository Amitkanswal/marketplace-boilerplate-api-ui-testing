{
  "id": "extension_field_in_modular_blocks",
  "name": "Extension Field Inside Modular Blocks",
  "description": "Tests setData called directly on location.CustomField.field for the JSON extension_field embedded inside a widget_block modular block. Validates Zod union(array, record) enforcement: objects and arrays resolve; string, number, and boolean primitives throw; null clears the field.",
  "contentType": {
    "uid": "sdk_tc_ext_in_blocks",
    "title": "SDK TC - Extension Field In Modular Blocks",
    "description": "Content type with modular blocks where one block type contains a JSON extension field",
    "options": {
      "is_page": false,
      "singleton": false,
      "title": "title"
    },
    "schema": [
      {
        "uid": "title",
        "data_type": "text",
        "display_name": "Title",
        "mandatory": true,
        "unique": false,
        "field_metadata": {
          "_default": true
        },
        "multiple": false
      },
      {
        "uid": "components",
        "data_type": "blocks",
        "display_name": "Components",
        "mandatory": false,
        "unique": false,
        "multiple": true,
        "blocks": [
          {
            "uid": "text_block",
            "title": "Text Block",
            "schema": [
              {
                "uid": "body",
                "data_type": "text",
                "display_name": "Body",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false,
                "min": 3
              }
            ]
          },
          {
            "uid": "widget_block",
            "title": "Widget Block",
            "schema": [
              {
                "uid": "label",
                "data_type": "text",
                "display_name": "Label",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false
              },
              {
                "uid": "extension_field",
                "data_type": "json",
                "display_name": "Extension Field",
                "mandatory": false,
                "unique": false,
                "field_metadata": {
                  "extension": true,
                  "allow_json_rte": false
                },
                "multiple": false
              }
            ]
          },
          {
            "uid": "image_block",
            "title": "Image Block",
            "schema": [
              {
                "uid": "asset",
                "data_type": "file",
                "display_name": "Asset",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false
              },
              {
                "uid": "caption",
                "data_type": "text",
                "display_name": "Caption",
                "mandatory": false,
                "unique": false,
                "field_metadata": {},
                "multiple": false
              }
            ]
          }
        ]
      }
    ]
  },
  "baseline": {
    "title": "SDK TC Extension In Modular Blocks Entry",
    "components": [
      {
        "widget_block": {
          "label": "My Widget",
          "extension_field": {
            "theme": "dark"
          }
        }
      }
    ]
  },
  "testCases": [
    {
      "id": "TC-H-001",
      "name": "Custom Field setData: valid object → resolves, no onError",
      "description": "Calls setData directly on location.CustomField.field with a plain object. Passes Zod union(array, record).",
      "operation": {
        "type": "custom-field-setdata",
        "subscribeFieldOnErrorUid": "extension_field",
        "data": { "theme": "light", "size": "sm" }
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-H-002",
      "name": "Custom Field setData: valid array → resolves, no onError",
      "description": "Calls setData directly on location.CustomField.field with an array. Array form is accepted by Zod union(array, record).",
      "operation": {
        "type": "custom-field-setdata",
        "subscribeFieldOnErrorUid": "extension_field",
        "data": ["option_a", "option_b"]
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-H-003",
      "name": "Custom Field setData: null clearing → resolves, no onError",
      "description": "Calls setData(null) on location.CustomField.field. Null clears the JSON extension field.",
      "operation": {
        "type": "custom-field-setdata",
        "subscribeFieldOnErrorUid": "extension_field",
        "data": null
      },
      "expected": {
        "setData": {
          "outcome": "resolved"
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-H-004",
      "name": "Custom Field setData: string primitive → throws ValidationError",
      "description": "Calls setData on location.CustomField.field with a string. String fails Zod union(array, record) for a JSON extension field.",
      "operation": {
        "type": "custom-field-setdata",
        "subscribeFieldOnErrorUid": "extension_field",
        "data": "#0070f3"
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "extension_field",
                "reasons": [
                  {
                    "message": "Expected a valid JSON value"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-H-005",
      "name": "Custom Field setData: number → throws ValidationError INVALID_TYPE",
      "description": "Calls setData on location.CustomField.field with a number. Number fails Zod union(array, record).",
      "operation": {
        "type": "custom-field-setdata",
        "subscribeFieldOnErrorUid": "extension_field",
        "data": 42
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "extension_field",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    },
    {
      "id": "TC-H-006",
      "name": "Custom Field setData: boolean → throws ValidationError INVALID_TYPE",
      "description": "Calls setData on location.CustomField.field with a boolean. Boolean fails Zod union(array, record).",
      "operation": {
        "type": "custom-field-setdata",
        "subscribeFieldOnErrorUid": "extension_field",
        "data": true
      },
      "expected": {
        "setData": {
          "outcome": "threw-ValidationError",
          "error": {
            "code": "VALIDATION_ERROR",
            "details": [
              {
                "fieldUid": "extension_field",
                "reasons": [
                  {
                    "reason": "INVALID_TYPE"
                  }
                ]
              }
            ]
          }
        },
        "fieldOnError": {
          "fired": false
        },
        "entryOnError": {
          "fired": false
        }
      }
    }
  ],
  "sdkDeUiLocation": "custom-field",
  "sdkDeCustomFieldUid": "extension_field",
  "isExperimental": true
}
